{
  "name": "@muxiuesd/dsh-pixel-studio",
  "version": "0.6.0",
  "description": "在 DSH 里画像素画：三栏编辑器（左工具 / 中画布 / 右调色板），连续缩放、直线 / 矩形 / 椭圆（可填充）、图层、矩形选区、最多 256 色调色板（可导入导出 JSON），支持 2048×2048 画布，导出 PNG 与调色板 JSON。",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.png",
  "license": "MIT",
  "author": "Muxiuesd",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/muxiuesd12138/dsh-pixel.git"
  },
  "homepage": "https://gitee.com/muxiuesd12138/dsh-pixel",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pixel-art",
    "pixel-editor"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.png",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
